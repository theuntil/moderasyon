# Dokploy > Environment sekmesine yapıştırılacak değişkenler.
# Lokal geliştirme için: cp .env.example .env

POSTGRES_USER=moderation
POSTGRES_PASSWORD=
POSTGRES_DB=moderation

REDIS_PASSWORD=

# Üretmek için: openssl rand -hex 32
# DİKKAT: Bu değer değişirse mevcut tüm API key'ler geçersiz olur.
API_KEY_PEPPER=

API_WORKERS=4

# Panelin entegrasyon örneklerinde gösterilecek public API adresi
PUBLIC_API_URL=https://moderation.rovandcloud.com

# Panel girişi e-postayla yapılır. Hiç yönetici yokken ilk açılışta bu bilgilerle "owner" oluşturulur.
# Eski kurulumda kullanıcı adıyla açılmış hesap varsa (ADMIN_USERNAME), e-postası bu adrese bağlanır.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Giriş yapılamıyorsa (şifre unutuldu, hesap kilitlendi): true yapıp yeniden deploy edin. ADMIN_EMAIL
# hesabının şifresi ADMIN_PASSWORD olur, kilit açılır. Aynı şifreyle yalnızca bir kez uygulanır.
ADMIN_RESET_PASSWORD=false

# Panel istatistiklerinde gün/saat sınırları bu saat dilimine göre hesaplanır
PANEL_TIMEZONE=Europe/Istanbul

# Not: Karar eşikleri, hız sınırları ve hizmet açık/kapalı durumu
# artık admin panelinden yönetilir; buraya yazmanıza gerek yok.

# --- Görsel / video işçisi kaynak sınırı (KVM 8: 8 vCPU / 32 GB için önerilen)
MEDIA_WORKER_CPUS=4
MEDIA_WORKER_MEMORY=4g

# --- Layer 2: AI (isteğe bağlı). Boşsa kapalı. platform.openai.com → API keys.
# Sağlayıcı (ücretsiz Moderation API / ücretli model), model, günlük-aylık bütçe ve limitler
# panelden yönetilir: AI ve maliyet sayfası.
AI_API_KEY=

# --- Yedekleme: günlük pg_dump, bu kadar gün saklanır
BACKUP_KEEP_DAYS=7

# --- Cloudflare R2: TÜM medya burada (sunucuya medya yazılmaz). Zorunlu: görsel/video için.
# Cloudflare → R2 → bucket oluştur (herkese açık erişim KAPALI) → Manage API tokens →
# "Object Read & Write", sadece bu bucket. Account ID R2 sayfasının sağında yazar.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Bucket'ı AB veri yerleşimiyle (EU jurisdiction) oluşturduysanız: eu
R2_JURISDICTION=
